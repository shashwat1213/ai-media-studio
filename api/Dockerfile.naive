# NAIVE single-stage image — kept ONLY as the "before" for the size comparison.
# Not used anywhere. See api/Dockerfile for the real one.
# Build:  docker build -f api/Dockerfile.naive -t ams-api:naive api
FROM node:22.23.3-alpine3.24
WORKDIR /app
COPY . .
RUN npm ci && npm run build
CMD ["npm", "start"]
