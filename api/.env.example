NODE_ENV=development
PORT=4000
# Host port 5433 -> compose postgres (5432 on host is used by another project)
DATABASE_URL=postgresql://studio:studio@localhost:5433/ai_media_studio?schema=public
CORS_ORIGIN=http://localhost:5173
# Auth — generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
JWT_TTL_DAYS=7
BCRYPT_COST=12
SIGNUP_BONUS_CREDITS=50
AUTH_RATE_LIMIT=20
# Observability
LOG_LEVEL=info
# Protects GET /metrics (>=16 chars). Required in production.
METRICS_TOKEN=dev-metrics-token-change-me

# --- Phase 2: generation ---
REDIS_URL=redis://localhost:6379
# S3-compatible storage. Locally: Silo/MinIO from docker compose. In AWS: leave the endpoint
# and keys unset (real S3 + the ECS task's IAM role).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-media-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900
# AI provider: 'stub' (free fake images, default) or 'openrouter' (real, PAID - needs a key).
AI_PROVIDER=stub
OPENROUTER_API_KEY=
STUB_DELAY_MS=2500
MAX_ACTIVE_JOBS_PER_USER=3
JOB_TIMEOUT_MINUTES=10
JOB_MAX_ATTEMPTS=3
GENERATE_RATE_LIMIT=30
# Worker process (npm run dev:worker)
WORKER_PORT=4001
WORKER_CONCURRENCY=4
